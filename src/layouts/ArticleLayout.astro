---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { site } from '../config';
import { displayDescription, displayTitle, entrySummary, entryURL, tagURL, type Entry, type Section } from '../content-utils';

interface Props {
  item: Entry;
  section: Section;
  sectionLabel: string;
  headings: MarkdownHeading[];
  prev?: Entry | null;
  next?: Entry | null;
}

const { item, section, sectionLabel, headings, prev = null, next = null } = Astro.props;
const tocHeadings = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const { date, updated, tags, demo } = item.data;
const read = item.collection === 'works' ? undefined : item.data.read;
const source = item.collection === 'notes' ? item.data.src : undefined;
const summary = entrySummary(item);
const title = displayTitle(item.data.title, demo);
const description = displayDescription(summary, demo);
const articleURL = new URL(entryURL(item), Astro.site || `https://${site.domain}/`).href;
const isWork = item.collection === 'works';
const imagePath = `/og/${item.collection}/${item.id}.png`;
const imageURL = new URL(imagePath, Astro.site || `https://${site.domain}/`).href;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': isWork ? 'CreativeWork' : 'BlogPosting',
  ...(isWork ? { name: title } : { headline: title }),
  description,
  url: articleURL,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleURL },
  image: [imageURL],
  inLanguage: 'zh-CN',
  ...(!site.authorDemo && !demo ? {
    author: { '@type': 'Person', name: site.author },
    publisher: { '@type': 'Person', name: site.author },
  } : {}),
  ...(date ? { datePublished: date } : {}),
  ...(updated || date ? { dateModified: updated || date } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
  ...(source ? { about: source } : {}),
};
---
<BaseLayout title={`${title} · ${site.name}`} description={description} active={section} demo={demo} image={imagePath} type="article" published={date} modified={updated || date}>
  <script type="application/ld+json" slot="ld-json" set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')} />
  <div class="progress-bar" aria-hidden="true"><i id="progFill"></i></div>
  <div class="container">
    <div class:list={['article-layout', { 'without-toc': !tocHeadings.length }]} data-detail-page>
      {tocHeadings.length > 0 && (
        <nav class="toc toc-desktop" id="articleToc" aria-label="本文目录" data-article-toc>
          <div class="tt">本文目录</div>
          <ol>
            {tocHeadings.map(heading => (
              <li>
                <a href={`#${encodeURIComponent(heading.slug)}`} data-heading-id={heading.slug} class:list={{ 'toc-subheading': heading.depth === 3 }}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <div class="article-col">
        <a class="article-return" data-return-list href={`/${section}/`}>返回{sectionLabel}列表</a>
        <header class="article-head">
          <div class="crumb">{sectionLabel}</div>
          <h1>{item.data.title}</h1>
          {demo && (
            <div class="demo-notice">
              <strong class="demo-label">演示内容</strong>
              <p>本文用于站点展示，不代表已核实的个人经历或项目成果。</p>
            </div>
          )}
          <p class="article-summary">{summary}</p>
          {(date || read || source) && (
            <div class="by">
              {date && <span>发布于 <time datetime={date}>{date}</time></span>}
              {read && <span>约 {read}</span>}
              {source && <span class="src">来源：{source}</span>}
            </div>
          )}
          {tags.length > 0 && (
            <div class="atags">
              {tags.map(tag => <a class="tag" href={tagURL(tag)} rel="tag">{tag}</a>)}
            </div>
          )}
        </header>
        <slot name="details" />
        {tocHeadings.length > 0 && (
          <details class="toc toc-mobile" id="articleTocMobile" data-article-toc>
            <summary>本文目录</summary>
            <nav aria-label="本文目录">
              <ol>
                {tocHeadings.map(heading => (
                  <li>
                    <a href={`#${encodeURIComponent(heading.slug)}`} data-heading-id={heading.slug} class:list={{ 'toc-subheading': heading.depth === 3 }}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )}
        {tocHeadings.length > 0 && (
          <button class="toc-reopen" id="tocReopen" type="button" aria-controls="articleTocMobile" aria-expanded="false" hidden>本文目录</button>
        )}
        <article class="prose" id="articleBody">
          <slot />
        </article>
        {(prev || next || updated || read) && (
          <footer class="article-foot">
            {(prev || next) && (
              <nav class="pager" aria-label="上下篇">
                {prev && (
                  <a href={entryURL(prev)} rel="prev" data-detail-link>
                    <span class="pager-label">上一篇</span>
                    <span>← {displayTitle(prev.data.title, prev.data.demo)}</span>
                  </a>
                )}
                {next && (
                  <a class="pager-next" href={entryURL(next)} rel="next" data-detail-link>
                    <span class="pager-label">下一篇</span>
                    <span>{displayTitle(next.data.title, next.data.demo)} →</span>
                  </a>
                )}
              </nav>
            )}
            {(updated || read) && (
              <div class="readinfo">
                {updated && <span>最后修订 <time datetime={updated}>{updated}</time></span>}
                {updated && read && <span aria-hidden="true"> · </span>}
                {read && <span>约 {read}</span>}
              </div>
            )}
          </footer>
        )}
      </div>
      {tocHeadings.length > 0 && <div class="article-spacer" aria-hidden="true"></div>}
    </div>
  </div>
</BaseLayout>

<script>
  const article = document.getElementById('articleBody');
  const fill = document.getElementById('progFill');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-article-toc] a[data-heading-id]'));
  const mobileToc = document.querySelector<HTMLDetailsElement>('#articleTocMobile');
  const reopen = document.querySelector<HTMLButtonElement>('#tocReopen');
  const mobile = window.matchMedia('(max-width: 900px)');

  if (article) {
    // Keep controls outside pre/code: Shiki markup and copy source stay untouched.
    article.querySelectorAll('pre').forEach((pre, index) => {
      const code = pre.querySelector('code');
      if (!code) return;
      const tools = document.createElement('div');
      tools.className = 'code-tools';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = '复制代码';
      button.setAttribute('aria-label', `复制第 ${index + 1} 段代码`);
      const status = document.createElement('span');
      status.className = 'copy-status';
      status.id = `copy-status-${index + 1}`;
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      status.setAttribute('aria-atomic', 'true');
      button.setAttribute('aria-describedby', status.id);
      tools.append(button, status);
      pre.before(tools);
      button.addEventListener('click', async () => {
        button.disabled = true;
        status.textContent = '';
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          status.textContent = '代码已复制。';
        } catch {
          status.textContent = '复制失败，请选中下方代码手动复制。';
        } finally {
          button.disabled = false;
        }
      });
    });
    const headingIds = new Set(links.map(link => link.dataset.headingId));
    const headings = Array.from(article.querySelectorAll<HTMLElement>('h2[id], h3[id]'))
      .filter(heading => headingIds.has(heading.id));
    headings.forEach(heading => {
      if (!heading.hasAttribute('tabindex')) heading.tabIndex = -1;
    });

    const tocPlaceholder = document.createElement('div');
    tocPlaceholder.setAttribute('aria-hidden', 'true');
    function closeFloatingToc(restoreFocus = false) {
      if (!mobileToc?.classList.contains('toc-floating')) return;
      mobileToc.open = false;
      mobileToc.classList.remove('toc-floating');
      tocPlaceholder.remove();
      reopen?.setAttribute('aria-expanded', 'false');
      if (reopen) reopen.textContent = '本文目录';
      if (restoreFocus) reopen?.focus({ preventScroll: true });
    }
    reopen?.addEventListener('click', () => {
      if (!mobileToc) return;
      if (mobileToc.classList.contains('toc-floating')) {
        closeFloatingToc(true);
        return;
      }
      tocPlaceholder.style.height = `${mobileToc.getBoundingClientRect().height}px`;
      tocPlaceholder.style.marginBottom = getComputedStyle(mobileToc).marginBottom;
      mobileToc.before(tocPlaceholder);
      mobileToc.classList.add('toc-floating');
      mobileToc.open = true;
      reopen.setAttribute('aria-expanded', 'true');
      reopen.textContent = '关闭目录';
      mobileToc.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && mobileToc?.classList.contains('toc-floating')) {
        event.preventDefault();
        closeFloatingToc(true);
      }
    });

    function updateReadingState() {
      const bounds = article!.getBoundingClientRect();
      const offset = parseFloat(getComputedStyle(article!).getPropertyValue('--article-anchor-offset')) * parseFloat(getComputedStyle(document.documentElement).fontSize) || 96;
      const maximum = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const top = bounds.top + window.scrollY;
      const start = Math.min(maximum, Math.max(0, top - offset));
      // Long articles end when their final viewport has been reached. For short
      // articles use one body's travel past the reading line, capped by page end.
      // No viewport is counted as read at the start; an unscrollable page stays 0.
      const end = Math.min(maximum, Math.max(start + Math.min(bounds.height, window.innerHeight), top + bounds.height - window.innerHeight));
      const ratio = end > start ? Math.max(0, Math.min(1, (window.scrollY - start) / (end - start)))
        : maximum > 0 && window.scrollY >= maximum ? 1 : 0;
      if (fill) fill.style.width = `${(ratio * 100).toFixed(1)}%`;
      if (!mobile.matches) closeFloatingToc();
      if (reopen) {
        const floating = mobileToc?.classList.contains('toc-floating');
        reopen.hidden = !mobile.matches || (!floating && !(bounds.height > window.innerHeight * 2 && bounds.top < -window.innerHeight * .5 && bounds.bottom > offset));
      }

      let active: string | null = null;
      const line = (headings[0] ? parseFloat(getComputedStyle(headings[0]).scrollMarginTop) : 96) + 1;
      headings.forEach(heading => {
        if (heading.getBoundingClientRect().top <= line) active = heading.id;
      });
      const lastHeading = headings[headings.length - 1];
      const atBottom = window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      if (atBottom && lastHeading && lastHeading.getBoundingClientRect().top < window.innerHeight) active = lastHeading.id;
      links.forEach(link => {
        const current = link.dataset.headingId === active;
        link.classList.toggle('active', current);
        if (current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }

    let frame = 0;
    function scheduleUpdate() {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        updateReadingState();
      });
    }

    links.forEach(link => {
      link.addEventListener('click', event => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const heading = headings.find(heading => heading.id === link.dataset.headingId);
        if (!heading) return;
        event.preventDefault();
        const disclosure = link.closest('details');
        if (disclosure) disclosure.open = false;
        closeFloatingToc();
        requestAnimationFrame(() => {
          if (window.location.hash !== link.hash) window.history.pushState(window.history.state, '', link.hash);
          heading.focus({ preventScroll: true });
          heading.scrollIntoView({
            block: 'start',
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
          scheduleUpdate();
        });
      });
    });

    mobileToc?.addEventListener('toggle', () => {
      if (!mobileToc.open) closeFloatingToc(mobileToc.classList.contains('toc-floating'));
      scheduleUpdate();
    });
    new ResizeObserver(scheduleUpdate).observe(article);
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);
    updateReadingState();
  }
</script>

<style>
  .article-layout { --article-anchor-offset: 6rem; }
  .article-layout.without-toc { grid-template-columns: minmax(0, var(--read)); }
  .article-return { display: inline-block; margin-bottom: 1.35rem; font-size: .875rem; font-family: var(--ui); }
  .article-return:hover { text-decoration: underline; text-underline-offset: .2em; }
  .article-head .by { display: flex; flex-wrap: wrap; gap: .3rem 1rem; font-family: var(--ui); font-size: .875rem; font-style: normal; color: var(--muted); }
  .article-head .by .src { margin-left: 0; }
  .article-head .atags { flex-wrap: wrap; }
  .article-summary { margin: .9rem 0; color: var(--muted); line-height: 1.85; overflow-wrap: anywhere; }
  .demo-notice { margin: .9rem 0; padding: .8rem 1rem; border-left: 3px solid var(--accent); background: var(--paper); }
  .demo-label { display: inline-block; font-size: .875rem; letter-spacing: .08em; color: var(--accent); }
  .demo-notice p { margin-top: .3rem; font-size: .875rem; color: var(--muted); line-height: 1.7; }
  .toc-desktop { display: block; position: sticky; top: var(--article-anchor-offset); max-height: calc(100vh - var(--article-anchor-offset) - 1.5rem); }
  .toc-mobile, .toc-reopen { display: none; }
  .toc-reopen[hidden] { display: none; }
  .toc-reopen, .prose :global(.code-copy) { min-height: 44px; padding: .4rem .8rem; border: 1px solid var(--rule2); border-radius: var(--r); color: var(--ink); background: var(--paper); font-family: var(--ui); font-size: .875rem; cursor: pointer; }
  .toc-reopen:focus-visible, .prose :global(.code-copy:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .prose :global(.code-tools) { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: .4rem .75rem; margin: 1.2rem 0 .35rem; }
  .prose :global(.code-tools + pre) { margin-top: 0; }
  .prose :global(.copy-status) { color: var(--muted); font-family: var(--ui); font-size: .875rem; line-height: 1.6; }
  .prose :global(.code-copy:disabled) { cursor: wait; opacity: .7; }
  .toc ol { list-style: none; padding: 0; margin: 0; }
  .toc a { overflow-wrap: anywhere; }
  .toc a.toc-subheading { padding-left: 1.5rem; font-size: .875rem; }
  .toc a:focus-visible, .article-return:focus-visible, .pager a:focus-visible, .atags a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .pager { width: 100%; flex-wrap: wrap; justify-content: space-between; }
  .pager a { display: flex; flex: 1 1 14rem; flex-direction: column; gap: .25rem; overflow-wrap: anywhere; }
  .pager .pager-next { margin-left: auto; text-align: right; }
  .pager-label { font-size: .875rem; color: var(--muted); }
  .prose { min-width: 0; overflow-wrap: anywhere; }
  .prose :global(h2), .prose :global(h3) { scroll-margin-top: var(--article-anchor-offset); }
  .prose :global(h2:focus-visible), .prose :global(h3:focus-visible) { outline: 2px solid var(--accent); outline-offset: .3rem; }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; overscroll-behavior-x: contain; }
  .prose :global(pre code) { overflow-wrap: normal; white-space: pre; }
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; margin: 1.2rem 0; border-collapse: collapse; overscroll-behavior-x: contain; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--rule); padding: .5rem .75rem; }
  .prose :global(iframe), .prose :global(video), .prose :global(svg) { max-width: 100%; }

  @media (max-width: 900px) {
    .article-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .article-layout.without-toc { grid-template-columns: minmax(0, 1fr); }
    .toc-desktop, .article-spacer { display: none; }
    .toc-mobile { display: block; position: static; max-height: none; overflow: visible; margin-bottom: 1.6rem; padding: .4rem 1rem; border: 1px solid var(--rule); border-radius: var(--r); background: var(--paper); }
    .toc-mobile summary { min-height: 44px; padding: .55rem 0; cursor: pointer; font-family: var(--kai); font-size: 1rem; color: var(--accent); }
    .toc-mobile summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .toc-mobile nav { max-height: min(55vh, 24rem); overflow-y: auto; padding: .4rem 0 .6rem; border-top: 1px solid var(--rule); }
    .toc-mobile a { padding-top: .65rem; padding-bottom: .65rem; }
    .toc-reopen { display: block; position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1.25rem, env(safe-area-inset-bottom)); z-index: 31; box-shadow: 0 2px 12px color-mix(in srgb, var(--ink) 10%, transparent); }
    .toc-mobile.toc-floating { position: fixed; z-index: 30; top: auto; left: max(1rem, env(safe-area-inset-left)); right: max(1rem, env(safe-area-inset-right)); bottom: calc(max(1.25rem, env(safe-area-inset-bottom)) + 3.25rem); max-height: calc(100dvh - 10rem); margin: 0; overflow-y: auto; box-shadow: 0 2px 16px color-mix(in srgb, var(--ink) 12%, transparent); }
    .toc-mobile.toc-floating nav { max-height: min(45dvh, 24rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .progress-bar i, .toc a { transition: none; }
  }
</style>
